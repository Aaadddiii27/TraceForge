# ─────────────────────────────────────────────────────────────────────────────
# AI Runtime & Evaluation Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=AI Runtime Platform
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# ─── API Server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# ─── Security ─────────────────────────────────────────────────────────────────
# WARNING: Authentication is DISABLED in development mode.
# Set ENABLE_AUTH=true and generate a strong SECRET_KEY for production.
ENABLE_AUTH=false
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_runtime
POSTGRES_USER=ai_runtime_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
DATABASE_URL=postgresql+asyncpg://ai_runtime_user:CHANGE_ME_IN_PRODUCTION@localhost:5432/ai_runtime

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ─── Execution Engine ─────────────────────────────────────────────────────────
DEFAULT_TASK_TIMEOUT_SECONDS=30
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=1.0
MAX_CONCURRENT_TASKS=10

# ─── Tool Registry ────────────────────────────────────────────────────────────
CALCULATOR_TIMEOUT_SECONDS=5
TEXT_PROCESSOR_TIMEOUT_SECONDS=10
KNOWLEDGE_BASE_TIMEOUT_SECONDS=10
MOCK_TOOL_TIMEOUT_SECONDS=2

# ─── Payload Logging & Retention ─────────────────────────────────────────────
# Controls how much of request/response payloads are stored in telemetry.
# Options: none | metadata_only | full
PAYLOAD_LOG_LEVEL=metadata_only
# Execution record retention in days (0 = keep forever)
EXECUTION_RETENTION_DAYS=30

# ─── OpenTelemetry ────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-runtime-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Set to false to use console exporter instead
OTEL_EXPORT_TO_COLLECTOR=false

# ─── Prometheus ───────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true

# ─── Model Providers (all optional) ──────────────────────────────────────────
# The platform works fully without any provider key using the MockProvider.

# Default provider used when none is specified
# Options: mock | openai | gemini
DEFAULT_MODEL_PROVIDER=mock

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000

# Google Gemini (optional)
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash
GEMINI_MAX_TOKENS=1000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE=AI Runtime Platform
